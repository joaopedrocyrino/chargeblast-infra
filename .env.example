# ---------------------------------------------------------------------------
# Local development environment for docker compose (compose.yaml).
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Compose project name (prefixes containers, networks and volumes).
COMPOSE_PROJECT_NAME=chargeblast

# Paths to the sibling application repositories (relative to this directory).
FRONTEND_PATH=../chargeblast-frontend
BACKEND_PATH=../chargeblast-backend

# PostgreSQL credentials for the LOCAL database only.
POSTGRES_USER=chargeblast
POSTGRES_PASSWORD=chargeblast_local_password
POSTGRES_DB=chargeblast

# Host port where PostgreSQL is published for local tools/tests.
# 5433 avoids clashing with a natively installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433

# Host ports for the application services.
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=4000

# Seed the database with deterministic demo data on backend start (true/false).
SEED_ON_START=true

# Most payments the public demo accepts before "Create payment" is refused.
PAYMENT_CREATE_LIMIT=3000
