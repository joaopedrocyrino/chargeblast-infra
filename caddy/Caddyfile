# Production edge. Caddy is the only container with published ports (80/443);
# it obtains TLS certificates automatically and forwards to the app containers
# over the private Docker network. PostgreSQL is never reachable from here.
{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		-X-Powered-By
	}
}

# Dashboard (Next.js)
{$FRONTEND_DOMAIN} {
	import common
	reverse_proxy frontend:3000
}

# Public API (NestJS); CORS is enforced by the API itself.
{$API_DOMAIN} {
	import common
	reverse_proxy backend:4000
}
