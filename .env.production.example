# ---------------------------------------------------------------------------
# Production settings for compose.prod.yaml. Copy to `.env.production`,
# fill in the secrets and never commit the copy.
# ---------------------------------------------------------------------------

# Public hostnames (DNS A/AAAA records → the VPS, ideally proxied, see below).
FRONTEND_DOMAIN=chargeblast.cyrinosoftware.com
API_DOMAIN=api-chargeblast.cyrinosoftware.com

# Let's Encrypt account e-mail for Caddy's automatic certificates.
ACME_EMAIL=

# PostgreSQL (internal network only; no domain, no published port).
POSTGRES_USER=chargeblast
POSTGRES_PASSWORD=
POSTGRES_DB=chargeblast

# Most payments the public demo accepts before "Create payment" is refused.
PAYMENT_CREATE_LIMIT=3000

# Paths to the sibling application repositories (relative to this directory).
FRONTEND_PATH=../chargeblast-frontend
BACKEND_PATH=../chargeblast-backend
